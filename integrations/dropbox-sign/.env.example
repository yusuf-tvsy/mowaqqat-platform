# Never commit actual values to GitHub. Configure in a private secret manager.
# For Dropbox Sign API callbacks this must be the PRIMARY API key.
DROPBOX_SIGN_WEBHOOK_KEY=
# Optional but recommended for app-scoped callbacks.
DROPBOX_SIGN_EXPECTED_APP_ID=
# Backend endpoint must be implemented with authentication and idempotent writes.
KADER_SIGN_SYNC_URL=https://kader.media/mowaqqat/api/integrations/dropbox-sign/events
KADER_SIGN_SYNC_TOKEN=
PORT=3001
